<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

  <x:Double x:Key="Font.Hero">30</x:Double>
  <x:Double x:Key="Font.PageTitle">24</x:Double>
  <x:Double x:Key="Font.Nav">22</x:Double>
  <x:Double x:Key="Font.Section">16</x:Double>
  <x:Double x:Key="Font.Headline">13</x:Double>
  <x:Double x:Key="Font.Body">13</x:Double>
  <x:Double x:Key="Font.Callout">12.5</x:Double>
  <x:Double x:Key="Font.Caption">11</x:Double>
  <x:Double x:Key="Font.Overline">9.5</x:Double>
  <x:Double x:Key="Font.Mono">11</x:Double>
  <x:Double x:Key="Font.MonoSmall">10</x:Double>

  <x:Double x:Key="Radius.Xs">2</x:Double>
  <x:Double x:Key="Radius.Sm">3</x:Double>
  <x:Double x:Key="Radius.Md">4</x:Double>
  <x:Double x:Key="Radius.Lg">8</x:Double>
  <x:Double x:Key="Radius.Xl">12</x:Double>
</ResourceDictionary>
