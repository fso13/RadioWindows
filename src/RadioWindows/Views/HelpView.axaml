<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RadioWindows.Controls"
             xmlns:vm="using:RadioWindows.ViewModels"
             x:Class="RadioWindows.Views.HelpView"
             x:DataType="vm:HelpViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="0">
      <TextBlock Text="{Binding Title}" Classes="pageTitle" />
      <TextBlock Text="{Binding Subtitle}" Classes="caption" Margin="0,4,0,0" />

      <ItemsControl ItemsSource="{Binding Topics}" Margin="0,20,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HelpTopicViewModel">
            <StackPanel Spacing="0">
              <Border Classes="rule" />
              <Button Classes="textButton" Command="{Binding ToggleCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Center" Height="46" Padding="0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Sign}" Classes="caption"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
              <StackPanel Spacing="8" Margin="0,0,0,14" IsVisible="{Binding IsExpanded}">
                <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="callout wrap"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
