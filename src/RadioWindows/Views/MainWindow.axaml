<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RadioWindows.Views"
        x:Class="RadioWindows.Views.MainWindow"
        Title="RadioWindows"
        Width="800"
        Height="680"
        MinWidth="800"
        MinHeight="680"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Icon="/Assets/app.ico">
  <views:ShellView />
</Window>
